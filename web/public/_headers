# Cloudflare Pages response headers (ignored by other hosts).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=3600

# Tile chunks never change: each archive's folder is named after its version.
/tiles/hitec-city-k4/chunks/*
  Cache-Control: public, max-age=31536000, immutable

# meta.json names the current archives, so it is checked again after a few minutes.
/tiles/hitec-city-k4/meta.json
  Cache-Control: public, max-age=300
